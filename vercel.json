{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "NODE_ENV": "production",
    "ANIWATCH_API_DEPLOYMENT_ENV": "vercel"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 3008,
      "maxDuration": 10,
      "runtime": "nodejs20.x"
    }
  }
}